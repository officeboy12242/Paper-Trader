# PaperTrader configuration. Copy to .env and edit.
# Never commit .env. API keys are read here and never sent to the dashboard.

# ---------------------------------------------------------------------------
# Safety (fixed in this build)
# ---------------------------------------------------------------------------
# Must be true. false refuses to start: there is no live execution adapter.
PAPER_TRADING=true

# ---------------------------------------------------------------------------
# Position sizing and risk
# ---------------------------------------------------------------------------
# Lots per trade. Quantity = LOT_SIZE x NSE F&O lot size of the symbol.
LOT_SIZE=1
# Where the per-symbol lot size comes from: nse (official fo_mktlots.csv, falls
# back to the WA-BOT table) or repo (WA-BOT table only).
LOT_SIZE_SOURCE=nse

# Minimum profit target from the fill. Unit: points (Rs per share, the repo's
# convention), rupees (gross Rs on the whole position) or percent.
MIN_TARGET=10
MIN_TARGET_UNIT=points

# Hard maximum stop from the fill (0.1-5). A tighter source stop always wins.
STOP_LOSS_PERCENT=5

# Trailing: armed when the target prints. The stop jumps to the lock level
# (TRAIL_LOCK_PCT of the target distance) and then follows the best price by
# TRAIL_DISTANCE. It never loosens. false = exit at the target.
TRAILING_ENABLED=true
TRAIL_DISTANCE=0.5
# percent | points | r (multiple of initial risk)
TRAIL_DISTANCE_UNIT=percent
TRAIL_LOCK_PCT=100

# ---------------------------------------------------------------------------
# Session (IST). Every WA-BOT source is intraday.
# ---------------------------------------------------------------------------
SESSION_OPEN=09:15
ENTRY_CUTOFF=15:00
EOD_SQUARE_OFF=15:20

# ---------------------------------------------------------------------------
# Strategy scheduling (mirrors WA-BOT tradeAlertScheduler)
# ---------------------------------------------------------------------------
TRADE_ALERT_TIME=09:20
TRADE_ALERT_MORNING_VOLATILITY_TIME=09:35
# TRADE_ALERT_HEATMAP2_TIMES=09:50,11:15
# TRADE_ALERT_PREOPEN_TIME=09:15
# TRADE_ALERT_TURNOVER_TIME=09:15
# Continuous rescans for sources whose inputs change intraday (0 = clock only).
SCAN_INTERVAL_MINUTES=15
PRICE_POLL_SECONDS=30
# Strategy scheduling: NSE sources trade ATM CE/PE option premiums (NSE option
# chain) instead of the underlying; gold/ETH trade their own 24h spot series.
NSE_TRADE_OPTIONS=true
# Option premium risk scale (premiums swing wider than equity: 30% stop,
# 60% target for 1:2, 3% trail).
NSE_OPTION_STOP_PCT=30
NSE_OPTION_MIN_TARGET_PCT=20
NSE_OPTION_TRAIL_PCT=3
# Original daily cap per source (WA-BOT TRADE_ALERT_MAX_SENDS).
MAX_TRADES_PER_STRATEGY_PER_DAY=5
# One position per symbol per strategy per day unless true.
ALLOW_DUPLICATE_POSITIONS=false
TRADE_ALERT_DAILY_SOFT_FALLBACK=true

# Per-strategy overrides (KEY = HEATMAP, HEATMAP2, PREOPEN, TURNOVER, NSE, LEGACY,
#   GOLD_SWEEP, GOLD_TREND, GOLD_BREAKOUT):
# STRATEGY_PREOPEN_ENABLED=false
# STRATEGY_HEATMAP_RESCAN_MINUTES=30
# STRATEGY_NSE_SCAN_TIMES=09:20,11:00
# STRATEGY_GOLD_SWEEP_ENABLED=false

# ---------------------------------------------------------------------------
# Gold 24h trader (XAUUSD spot, paper only, scans day and night)
# ---------------------------------------------------------------------------
# Delta India model: USD-quoted, INR-margined and INR-settled.
GOLD_MARGIN_INR=40000
GOLD_LEVERAGE=50
GOLD_STOP_RISK=15
GOLD_TARGET=40
# How often the gold traders rescan for a fresh setup (24h continuous).
GOLD_SCAN_INTERVAL_MINUTES=1
# INR per USD — converts the USD gold/ETH quote to the INR margin base.
INR_USD_RATE=84
# Risk controls: short cooldown after a stop-loss, and a daily loss limit per strategy.
STRATEGY_COOLDOWN_MINUTES=5
DAILY_LOSS_LIMIT_INR=5000

# ---------------------------------------------------------------------------
# ETH 24h trader (ETHUSD spot, paper only, scans day and night)
# ---------------------------------------------------------------------------
ETH_MARGIN_INR=40000
ETH_LEVERAGE=50
ETH_STOP_RISK=25
ETH_TARGET=60
ETH_SCAN_INTERVAL_MINUTES=1

# Original WA-BOT strategy settings the upstream engine actually reads:
# TRADE_ALERT_HEATMAP_MIN_MOVE_PCT=2
# TRADE_ALERT_HEATMAP_MAX=8
# TRADE_ALERT_NSE_GL_EACH=5
# TURNOVER_BAND_FROM=11
# TURNOVER_BAND_TO=30
# TRADE_ALERT_MIN_CONFLUENCE=40
# TRADE_ALERT_DISCOVERY_COUNT=10
# Note: HEATMAP_V2_* variables exist in WA-BOT config but the upstream heatmap2
# scanner is a singleton built without config, so they have no effect upstream
# either. heatmap2 runs on its coded defaults (min move 1.5%, score >= 60).

# ---------------------------------------------------------------------------
# AI gate (original WA-BOT LLM CE/PE analysis)
# ---------------------------------------------------------------------------
# auto = switch the original AI check on as soon as any key below is set.
# off  = never call an LLM (nse and legacy then stay idle).
AI_GATE_MODE=auto
# Any ONE of these is enough (provider chain: OrcaRouter, Gemini, Groq, NVIDIA, OpenRouter).
# ORCAROUTER_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# NVIDIA_API_KEY=
# OPENROUTER_API_KEY=
# TRADE_LLM_PROVIDERS=orcarouter,gemini,groq,nvidia,openrouter

# ---------------------------------------------------------------------------
# Execution simulation (Indian stock futures charges; verify current rates)
# ---------------------------------------------------------------------------
SLIPPAGE_BPS=2
FEE_BROKERAGE_FLAT=20
FEE_BROKERAGE_PCT=0.03
FEE_STT_SELL_PCT=0.02
FEE_EXCHANGE_PCT=0.00173
FEE_SEBI_PER_CRORE=10
FEE_STAMP_BUY_PCT=0.002
FEE_GST_PCT=18

# ---------------------------------------------------------------------------
# Statistics and ranking
# ---------------------------------------------------------------------------
# Capital base per strategy used for drawdown %.
CAPITAL_PER_STRATEGY=500000
RANK_WEIGHTS=netPnl:0.35,profitFactor:0.25,winRate:0.15,drawdown:0.15,trades:0.1
RANK_PF_CAP=3
RANK_DD_CAP_PCT=20
RANK_FULL_SAMPLE_TRADES=30

# ---------------------------------------------------------------------------
# Infrastructure
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:./data/papertrader.db
LOG_LEVEL=INFO
LOG_DIR=./logs
# Log level for the vendored WA-BOT modules (pino, lowercase).
VENDOR_LOG_LEVEL=warn
# Bind to 127.0.0.1 unless you put the dashboard behind your own auth.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
MARKET_DATA_CONCURRENCY=4
STALE_PRICE_SECONDS=300

# NSE blocks many foreign datacentre IPs. On a VPS outside India set one:
# NSE_PROXY_URL=http://user:pass@host:port
# SCRAPER_API_KEY=
