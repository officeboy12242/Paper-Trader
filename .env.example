# PaperTrader configuration. Copy to .env and edit.
# Never commit .env. API keys are read here and never sent to the dashboard.

# ---------------------------------------------------------------------------
# Safety (fixed in this build)
# ---------------------------------------------------------------------------
# Must be true. false refuses to start: there is no live execution adapter.
PAPER_TRADING=true

# ---------------------------------------------------------------------------
# Position sizing and risk
# ---------------------------------------------------------------------------
# Lots per trade. Quantity = LOT_SIZE x NSE F&O lot size of the symbol.
LOT_SIZE=1
# Where the per-symbol lot size comes from: nse (official fo_mktlots.csv, falls
# back to the WA-BOT table) or repo (WA-BOT table only).
LOT_SIZE_SOURCE=nse

# Minimum profit target from the fill. Unit: points (Rs per share, the repo's
# convention), rupees (gross Rs on the whole position) or percent.
MIN_TARGET=10
MIN_TARGET_UNIT=points

# Hard maximum stop from the fill (0.1-5). A tighter source stop always wins.
STOP_LOSS_PERCENT=5

# Trailing: armed when the target prints. The stop jumps to the lock level
# (TRAIL_LOCK_PCT of the target distance) and then follows the best price by
# TRAIL_DISTANCE. It never loosens. false = exit at the target.
TRAILING_ENABLED=true
TRAIL_DISTANCE=0.5
# percent | points | r (multiple of initial risk)
TRAIL_DISTANCE_UNIT=percent
TRAIL_LOCK_PCT=100

# ---------------------------------------------------------------------------
# Session (IST). Every WA-BOT source is intraday.
# ---------------------------------------------------------------------------
SESSION_OPEN=09:15
ENTRY_CUTOFF=15:00
EOD_SQUARE_OFF=15:20

# ---------------------------------------------------------------------------
# Strategy scheduling (mirrors WA-BOT tradeAlertScheduler)
# ---------------------------------------------------------------------------
TRADE_ALERT_TIME=09:20
TRADE_ALERT_MORNING_VOLATILITY_TIME=09:35
# TRADE_ALERT_HEATMAP2_TIMES=09:50,11:15
# TRADE_ALERT_PREOPEN_TIME=09:15
# TRADE_ALERT_TURNOVER_TIME=09:15
# Continuous rescans for sources whose inputs change intraday (0 = clock only).
SCAN_INTERVAL_MINUTES=15
PRICE_POLL_SECONDS=30
# Strategy scheduling: NSE sources trade ATM CE/PE option premiums (NSE option
# chain) instead of the underlying; gold/ETH trade their own 24h spot series.
NSE_TRADE_OPTIONS=true
# Option premium risk scale (premiums swing wider than equity: 30% stop,
# 60% target for 1:2, 3% trail).
NSE_OPTION_STOP_PCT=30
NSE_OPTION_MIN_TARGET_PCT=20
NSE_OPTION_TRAIL_PCT=3
# Original daily cap per source (WA-BOT TRADE_ALERT_MAX_SENDS).
MAX_TRADES_PER_STRATEGY_PER_DAY=5
# One position per symbol per strategy per day unless true.
ALLOW_DUPLICATE_POSITIONS=false
TRADE_ALERT_DAILY_SOFT_FALLBACK=true

# Per-strategy overrides (KEY = HEATMAP, HEATMAP2, PREOPEN, TURNOVER, NSE, LEGACY,
#   GOLD_SWEEP, GOLD_TREND, GOLD_BREAKOUT):
# STRATEGY_PREOPEN_ENABLED=false
# STRATEGY_HEATMAP_RESCAN_MINUTES=30
# STRATEGY_NSE_SCAN_TIMES=09:20,11:00
# STRATEGY_GOLD_SWEEP_ENABLED=false

# ---------------------------------------------------------------------------
# MongoDB mirror for future AI/RAG work (optional)
# ---------------------------------------------------------------------------
# When set, every signal and closed trade is mirrored to MongoDB in the
# background (SQLite stays the engine's source of truth). Never commit this.
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?appName=PaperTrader
MONGODB_DB=papertrader
# On a wiped/empty SQLite (e.g. Render redeploy wiped the disk), boot
# rehydrates strategies + open trades + working orders from the latest
# snapshot the engine uploads to `snapshot.kind:latest` once a minute.
MONGO_RESTORE=true

# ---------------------------------------------------------------------------
# Gold 24h trader (XAUUSD spot, paper only, scans day and night)
# ---------------------------------------------------------------------------
# Delta India model: USD-quoted, INR-margined and INR-settled.
GOLD_MARGIN_INR=40000
GOLD_LEVERAGE=50
GOLD_STOP_RISK=15
# How often the gold traders rescan for a fresh setup (24h continuous).
GOLD_SCAN_INTERVAL_MINUTES=1
# INR per USD — converts the USD gold/ETH quote to the INR margin base.
INR_USD_RATE=84
# Risk controls: short cooldown after a stop-loss, and a daily loss limit per strategy.
STRATEGY_COOLDOWN_MINUTES=5
DAILY_LOSS_LIMIT_INR=15000
# Gold/ETH: once unrealized profit reaches this, the stop locks that profit
# (breakeven + booking level) so a winner can never become a loser.
PROFIT_BOOK_INR=2000

# ---------------------------------------------------------------------------
# ETH 24h trader (ETHUSD spot, paper only, scans day and night)
# ---------------------------------------------------------------------------
ETH_MARGIN_INR=40000
ETH_LEVERAGE=50
ETH_STOP_RISK=25
ETH_SCAN_INTERVAL_MINUTES=1

# ---------------------------------------------------------------------------
# Per-trade SL / TP (gold + ETH) — derived from each trade's own setup
# ---------------------------------------------------------------------------
# Stop   = the setup's invalidation point, scaled to ATR x ATR_STOP_MULT and
#          never wider than ATR_STOP_MULT x ATR or <PREFIX>_STOP_RISK.
# Target = the nearest structural level (swing / day extreme / measured move)
#          that pays at least MIN_RR times that trade's own risk, capped at
#          MAX_RR. If no level pays MIN_RR the setup is refused: no trade.
# Guard  = one stop-loss can never cost more than MAX_RISK_INR; position size
#          is cut to fit it, so a wide stop never means a bigger loss.
MIN_RR=1.5
MAX_RR=4
ATR_STOP_MULT=3
MAX_RISK_INR=3000

# Original WA-BOT strategy settings the upstream engine actually reads:
# TRADE_ALERT_HEATMAP_MIN_MOVE_PCT=2
# TRADE_ALERT_HEATMAP_MAX=8
# TRADE_ALERT_NSE_GL_EACH=5
# TURNOVER_BAND_FROM=11
# TURNOVER_BAND_TO=30
# TRADE_ALERT_MIN_CONFLUENCE=40
# TRADE_ALERT_DISCOVERY_COUNT=10
# Note: HEATMAP_V2_* variables exist in WA-BOT config but the upstream heatmap2
# scanner is a singleton built without config, so they have no effect upstream
# either. heatmap2 runs on its coded defaults (min move 1.5%, score >= 60).

# ---------------------------------------------------------------------------
# AI gate (original WA-BOT LLM CE/PE analysis)
# ---------------------------------------------------------------------------
# auto = switch the original AI check on as soon as any key below is set.
# off  = never call an LLM (nse and legacy then stay idle).
AI_GATE_MODE=auto
# Any ONE of these is enough (provider chain: OrcaRouter, Gemini, Groq, NVIDIA, OpenRouter).
# ORCAROUTER_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# NVIDIA_API_KEY=
# OPENROUTER_API_KEY=
# TRADE_LLM_PROVIDERS=orcarouter,gemini,groq,nvidia,openrouter

# ---------------------------------------------------------------------------
# Execution simulation — fees follow the real venue for each instrument
# ---------------------------------------------------------------------------
SLIPPAGE_BPS=2

# NSE trades (equity + index options): Indian F&O turnover charges.
# Verify current rates against your broker's contract note.
FEE_BROKERAGE_FLAT=20
FEE_BROKERAGE_PCT=0.03
FEE_STT_SELL_PCT=0.02
FEE_EXCHANGE_PCT=0.00173
FEE_SEBI_PER_CRORE=10
FEE_STAMP_BUY_PCT=0.002
# GST applies to both venues (18% on the trading fee, per Indian law).
FEE_GST_PCT=18

# Gold + ETH settle on Delta Exchange, which charges a percentage of notional
# per side instead. Rates pulled live from
# GET https://api.india.delta.exchange/v2/products:
#   XAUTUSD (gold)  maker 0.01%  taker 0.01%
#   ETHUSD          maker 0.02%  taker 0.05%
# Every order this engine fires (market entry, stop entry, stop/target exit)
# takes liquidity, so both legs fill as taker.
DELTA_FEE_SIDE=taker
DELTA_FEE_GOLD_MAKER_PCT=0.01
DELTA_FEE_GOLD_TAKER_PCT=0.01
DELTA_FEE_ETH_MAKER_PCT=0.02
DELTA_FEE_ETH_TAKER_PCT=0.05

# ---------------------------------------------------------------------------
# Self-training (in-process, runs once a day inside the trading process)
# ---------------------------------------------------------------------------
# The trainer rebuilds a 16-feature logistic-regression gate from closed
# trades and swaps it in only when it beats a forward-chaining test. Nothing
# happens until ML_MIN_TRADES closed trades exist — until then the nightly run
# just logs "not enough closed trades". SQLite only; no extra service.
ML_TRAIN_ENABLED=true
ML_TRAIN_HOUR_IST=3
ML_MIN_TRADES=100
ML_MIN_TEST=20
ML_MIN_ACC=0.55
#   off     never score
#   shadow  score and record it, never veto (default — safe to leave on)
#   on      veto accepted setups scoring below ML_GATE_THRESHOLD
ML_GATE_MODE=shadow
ML_GATE_THRESHOLD=0.45
ML_KEEP_VERSIONS=12

# ---------------------------------------------------------------------------
# System-1 AI gate (Jev/Laya-style, powered by Groq) — the model only votes
# ---------------------------------------------------------------------------
# Jev is a paid "System 1" decision model; Laya (convaiinnovations/laya on
# Hugging Face) is its open Apache-2.0 clone, but nothing hosts it and it
# needs ~1GB+ to serve — too big for the Render starter. This gate gives the
# same "no reasoning, just a typed verdict" behaviour on Groq's always-on API:
# every setup that passes the rules is sent as a state and the model must
# answer with only {"take": yes|no|noul, "direction": buy|sell|neutral,
# "conviction": 0-100, "noul": confirm|deny|uncertain} — never prose.
#   off     never called
#   shadow  score + record every verdict, never veto (default — safe to leave on)
#   on      veto setups the model isn't decisively for (take != yes, wrong
#           direction, or conviction < SYSTEM1_CONVICTION_MIN)
# Works for ALL strategies, including gold/ETH 24h traders. The provider is
# SYSTEM1_PROVIDER (groq | gemini). Keys: for groq set SYSTEM1_API_KEY
# (dedicated) or GROQ_API_KEY (shared with the AI gate); for gemini set
# SYSTEM1_GEMINI_API_KEY (dedicated) or GEMINI_API_KEY or SYSTEM1_API_KEY.
SYSTEM1_GATE_MODE=shadow
SYSTEM1_PROVIDER=groq
# Empty = provider default (groq: openai/gpt-oss-120b, gemini: gemini-3.8-flash).
SYSTEM1_MODEL=
SYSTEM1_CONVICTION_MIN=60
SYSTEM1_TIMEOUT_MS=15000
SYSTEM1_MAX_PER_DAY=120
SYSTEM1_COOLDOWN_MS=600000
# SYSTEM1_API_KEY=
# SYSTEM1_GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Statistics and ranking
# ---------------------------------------------------------------------------
# Capital base per strategy used for drawdown %.
CAPITAL_PER_STRATEGY=500000
RANK_WEIGHTS=netPnl:0.35,profitFactor:0.25,winRate:0.15,drawdown:0.15,trades:0.1
RANK_PF_CAP=3
RANK_DD_CAP_PCT=20
RANK_FULL_SAMPLE_TRADES=30

# ---------------------------------------------------------------------------
# Infrastructure
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:./data/papertrader.db
LOG_LEVEL=INFO
LOG_DIR=./logs
# Log level for the vendored WA-BOT modules (pino, lowercase).
VENDOR_LOG_LEVEL=warn
# Bind to 127.0.0.1 unless you put the dashboard behind your own auth.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
MARKET_DATA_CONCURRENCY=4
STALE_PRICE_SECONDS=300

# NSE blocks many foreign datacentre IPs. On a VPS outside India set one:
# NSE_PROXY_URL=http://user:pass@host:port
# SCRAPER_API_KEY=
